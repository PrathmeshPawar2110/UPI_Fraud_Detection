# Copy this file to backend/.env and fill in what you need. backend/.env is git-ignored: never commit it.
# Every setting is optional locally. Real environment variables override this file.

# Signs session cookies. Set any long random text so you stay signed in across restarts.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database. Leave empty to use a local SQLite file (backend/upi_guard.db).
# Postgres examples:
#   DATABASE_URL=postgresql://postgres:upiguard@localhost:5432/postgres
#   DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---------- AI investigator (optional) ----------
# Pick ONE provider and fill in its block. Leave everything empty to disable the AI investigator.
# AI_PROVIDER = anthropic | openai | azure | gemini. If empty, the first provider with a key set is used.
AI_PROVIDER=
# Model name. Required for openai and gemini (check the provider's current model list);
# anthropic defaults to claude-opus-5-5; azure uses AZURE_OPENAI_DEPLOYMENT instead.
AI_MODEL=
# Questions per user per day (cost control)
# AI_DAILY_LIMIT=20

# Anthropic (Claude): key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI: key from https://platform.openai.com/api-keys  (also set AI_MODEL)
OPENAI_API_KEY=

# Google Gemini: key from https://aistudio.google.com/apikey  (also set AI_MODEL, e.g. a current Gemini Flash model)
GEMINI_API_KEY=

# Azure OpenAI: from your Azure OpenAI resource (Keys and Endpoint) and a model deployment
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=            # https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=          # the deployment name you created, e.g. gpt-4o-prod
# AZURE_OPENAI_API_VERSION=2024-10-21

# Limits
# SESSION_DAYS=7
# MAX_BODY_BYTES=1000000
# MAX_IMPORT_ROWS=2000
